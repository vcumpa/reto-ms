# URL del API Gateway (YARP) para desarrollo local con Vite.
# Se usa SOLO para configurar el proxy en vite.config.ts (dev server);
# en runtime del navegador el cliente Axios siempre llama a rutas
# relativas ("/auth/...", "/api/control/...") para evitar problemas de CORS,
# ya que el Gateway actual no envía cabeceras Access-Control-Allow-Origin.
#
# Ajusta el puerto al que realmente estés usando para levantar el
# ApiGateway (ver docs/walkthrough.md del backend: en la prueba manual
# usaron --urls=http://localhost:5000; el launchSettings.json trae 5280).
VITE_API_BASE_URL=http://localhost:5000

VITE_APP_NAME="Carga Masiva"

# Activar únicamente si se requieren mapas para depurar un build.
VITE_SOURCEMAP=false
